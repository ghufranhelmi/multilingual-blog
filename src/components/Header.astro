---
import { t, type Lang } from '../i18n/utils';
import { tx } from '../i18n/extra';
import LanguageSwitcher from './LanguageSwitcher.astro';
import BrandMark from './BrandMark.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(en|zh|es|ar|id|pt|fr|ja|ru)/, '');

const normalized = currentPath.replace(/\/+$/, '');
const isHome = normalized === `/${lang}`;
const isReviews = normalized.startsWith(`/${lang}/blog`);
---

<div class="topbar">
  <div class="container">
    <p>{tx(lang, 'disclosure')}</p>
  </div>
</div>

<header class="site-header">
  <nav class="container" aria-label="Main">
    <a href={`/${lang}`} class="logo">
      <BrandMark />
      <span>{t(lang, 'site.title')}</span>
    </a>
    <div class="nav-links">
      <a href={`/${lang}`} aria-current={isHome ? 'page' : undefined}>{t(lang, 'nav.home')}</a>
      <a href={`/${lang}/blog`} aria-current={isReviews ? 'page' : undefined}>{tx(lang, 'reviews')}</a>
      <LanguageSwitcher lang={lang} currentPath={currentPath} pathWithoutLang={pathWithoutLang} />
    </div>
  </nav>
</header>
