---
import { t, type Lang } from '../i18n/utils';
import { tx } from '../i18n/extra';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(en|zh|es|ar|id|pt|fr|ja|ru|de|it|ko)/, '');

const normalized = currentPath.replace(/\/+$/, '');
const isHome = normalized === `/${lang}`;
const isReviews = normalized.startsWith(`/${lang}/blog`);
---

<div class="topbar">
  <div class="container">
    <p>{tx(lang, 'disclosure')}</p>
  </div>
</div>

<header class="site-header">
  <nav class="container" aria-label="Main">
    <a href={`/${lang}`} class="logo">
      <!-- Menggunakan logo SVG baru -->
      <img src="/logo.svg" alt="Plug & Nest Logo" class="brand-logo" />
    </a>
    <div class="nav-links">
      <a href={`/${lang}`} aria-current={isHome ? 'page' : undefined}>{t(lang, 'nav.home')}</a>
      <a href={`/${lang}/blog`} aria-current={isReviews ? 'page' : undefined}>{tx(lang, 'reviews')}</a>
      <LanguageSwitcher lang={lang} currentPath={currentPath} pathWithoutLang={pathWithoutLang} />
    </div>
  </nav>
</header>

<style>
  .brand-logo {
    height: 32px; /* Sesuaikan tinggi logo jika terlalu besar/kecil */
    width: auto;
    display: block;
  }
</style>