---
import { languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  currentPath: string;
  pathWithoutLang: string;
}

const { lang, pathWithoutLang } = Astro.props;
const atRoot = pathWithoutLang === '/' || pathWithoutLang === '';
---

<div class="lang-dropdown">
  <button
    type="button"
    class="lang-toggle"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="lang-menu"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18" />
      <path d="M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
    </svg>
    <span>{languages[lang]}</span>
    <svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </button>
  <div id="lang-menu" class="lang-menu">
    {Object.entries(languages).map(([code, label]) => (
      <a
        href={atRoot ? `/${code}` : `/${code}${pathWithoutLang}`}
        lang={code}
        hreflang={code}
        data-lang={code}
        aria-current={lang === code ? 'true' : undefined}
      >
        {label}
      </a>
    ))}
  </div>
</div>

<style>
  .lang-dropdown { position: relative; }
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .lang-toggle:hover { border-color: var(--color-ink); }
  .lang-toggle .chev { color: var(--color-muted); }
  .lang-menu {
    display: none;
    position: absolute;
    top: 100%;
    inset-inline-end: 0;
    margin-top: 0.4rem;
    min-width: 180px;
    max-height: 320px;
    overflow-y: auto;
    padding: 0.35rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgba(14, 26, 43, 0.12);
    z-index: 100;
  }
  .lang-menu.open { display: flex; flex-direction: column; gap: 0.1rem; }
  .lang-menu a {
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    color: var(--color-text);
  }
  .lang-menu a:hover { background: var(--color-surface); color: var(--color-ink); }
  .lang-menu a[aria-current='true'] {
    background: var(--color-surface);
    color: var(--color-primary);
    font-weight: 600;
    box-shadow: none;
  }
</style>

<script>
  const toggle = document.querySelector('.lang-toggle');
  const menu = document.getElementById('lang-menu');

  const setOpen = (open) => {
    menu?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => setOpen(!menu?.classList.contains('open')));

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.lang-dropdown')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      setOpen(false);
      toggle?.focus();
    }
  });

  menu?.querySelectorAll('a[data-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('preferred-lang', a.getAttribute('data-lang') || '');
      } catch (_) {}
    });
  });
</script>


