---
import { localeForLang, type Lang } from '../i18n/utils';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      heroImage?: string;
    };
  };
  lang: Lang;
}

const { entry, lang } = Astro.props;
const slug = entry.id.replace(`${lang}/`, '');
const href = `/${lang}/blog/${slug}`;
const dateStr = entry.data.pubDate.toLocaleDateString(localeForLang(lang), {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="blog-card">
  <a href={href}>
    {entry.data.heroImage && (
      <img src={entry.data.heroImage} alt={entry.data.title} />
    )}
    <div class="card-body">
      <p class="card-date">{dateStr}</p>
      <h3 class="card-title">{entry.data.title}</h3>
      <p class="card-desc">{entry.data.description}</p>
    </div>
  </a>
</article>
